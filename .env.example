# ───────────── PaySynapse Environment Configuration ─────────────

# PostgreSQL Database Connection String
# For Local Development:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/paysynapse?schema=public"

# For Docker Compose:
# DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/paysynapse?schema=public"

# JWT Authentication Secret
JWT_SECRET="paysynapse_secure_jwt_secret_2026"

# Razorpay Sandbox Credentials (Optional for live webhook testing)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_webhook_secret"

# Google Gemini AI API Key (Optional for live Copilot & AI Investigation)
GEMINI_API_KEY=""
